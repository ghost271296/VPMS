<Window x:Class="VPMS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:VPMS.Converters"
        xmlns:models="clr-namespace:VPMS.Models"
        Title="VPMS — Vertiv Predictive Maintenance System"
        Height="820" Width="1200"
        MinHeight="700" MinWidth="1000"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
        <converters:HealthScoreToColorConverter x:Key="HealthColor"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="22" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="VPMS" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Vertiv Predictive Maintenance System" FontSize="14" Foreground="#99BBDD" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Session.UpsModel}" Foreground="#AAC8E8" FontSize="12" Margin="0,0,16,0"
                               Visibility="{Binding Session.UpsModel, Converter={StaticResource BoolVis}}"/>
                    <Button Content="New Session" Command="{Binding NewSessionCommand}"
                            Background="#2D5A8C" Foreground="White" BorderThickness="0"
                            Padding="12,6" Cursor="Hand" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left navigation sidebar -->
        <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="0"
                Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel>
                <!-- Pipeline steps -->
                <TextBlock Text="PIPELINE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="20,20,20,8" LetterSpacing="2"/>

                <ItemsControl x:Name="NavItems">
                    <ItemsControl.Items>
                        <StackPanel Tag="0"/>
                        <StackPanel Tag="1"/>
                        <StackPanel Tag="2"/>
                        <StackPanel Tag="3"/>
                        <StackPanel Tag="4"/>
                        <StackPanel Tag="5"/>
                        <StackPanel Tag="6"/>
                        <StackPanel Tag="7"/>
                    </ItemsControl.Items>
                </ItemsControl>

                <!-- Navigation list -->
                <ListBox x:Name="NavList" SelectionChanged="NavList_SelectionChanged"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderThickness="3,0,0,0" BorderBrush="Transparent">
                                            <ContentPresenter Margin="0"/>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="SelectionStates">
                                                    <VisualState x:Name="Selected">
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                To="{StaticResource AccentColor}" Duration="0"/>
                                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#F0F7FF" Duration="0"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                    <VisualState x:Name="Unselected"/>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBoxItem><ContentControl Content="Upload" Tag="0" Margin="20,6" FontSize="13"/></ListBoxItem>
                    <ListBoxItem><ContentControl Content="Issues" Tag="1" Margin="20,6" FontSize="13"/></ListBoxItem>
                    <ListBoxItem><ContentControl Content="Root Cause Analysis" Tag="2" Margin="20,6" FontSize="13"/></ListBoxItem>
                    <ListBoxItem><ContentControl Content="Field Questions" Tag="3" Margin="20,6" FontSize="13"/></ListBoxItem>
                    <ListBoxItem><ContentControl Content="Fishbone Diagram" Tag="4" Margin="20,6" FontSize="13"/></ListBoxItem>
                    <ListBoxItem><ContentControl Content="Corrective Actions" Tag="5" Margin="20,6" FontSize="13"/></ListBoxItem>
                    <ListBoxItem><ContentControl Content="Risk Prediction" Tag="6" Margin="20,6" FontSize="13"/></ListBoxItem>
                    <ListBoxItem><ContentControl Content="Export Report" Tag="7" Margin="20,6" FontSize="13"/></ListBoxItem>
                </ListBox>

                <Separator Style="{StaticResource HorizontalDivider}" Margin="20,12"/>

                <!-- Health index summary -->
                <Border Margin="12,0" Padding="12" CornerRadius="8" Background="{StaticResource BackgroundBrush}"
                        Visibility="{Binding Session.Health, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="HEALTH INDEX" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" LetterSpacing="1" Margin="0,0,0,8"/>
                        <TextBlock FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                   Text="{Binding Session.Health.OverallScore, StringFormat='{}{0:F0}'}"
                                   Foreground="{Binding Session.Health.OverallScore, Converter={StaticResource HealthColor}}"/>
                        <TextBlock Text="{Binding Session.Health.OverallStatus}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Progress bar -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" Padding="20,10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="{Binding CurrentStage}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text=" — Step " Style="{StaticResource CaptionText}"/>
                    <TextBlock Text="{Binding StageProgress}" Style="{StaticResource CaptionText}"/>
                    <TextBlock Text=" of " Style="{StaticResource CaptionText}"/>
                    <TextBlock Text="{Binding TotalStages}" Style="{StaticResource CaptionText}"/>
                </StackPanel>
                <ProgressBar Value="{Binding ProgressPct}" Maximum="100"
                             Style="{StaticResource VpmsProgress}" Height="6"/>
            </StackPanel>
        </Border>

        <!-- Main content area — stage switcher -->
        <ContentControl Grid.Row="2" Grid.Column="1" x:Name="MainContent"/>

        <!-- Error banner -->
        <Border Grid.Row="3" Grid.Column="1" Background="{StaticResource DangerBrush}" Padding="16,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
            <Grid>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                        Foreground="White" Command="{Binding DismissErrorCommand}" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Back / busy overlay -->
        <Border Grid.Row="2" Grid.Column="1" Background="#80000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding BusyMessage}" Foreground="White" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="6"
                             Style="{StaticResource VpmsProgress}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
