<UserControl x:Class="VPMS.Views.ActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VPMS.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
        <converters:ActionPriorityToColorConverter x:Key="ActionColor"/>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Corrective Action Plan" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Immediate -->
                <TextBlock Text="⚡ Immediate Actions" FontWeight="Bold" FontSize="15"
                           Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8"
                           Visibility="{Binding ImmediateActions.Count, Converter={StaticResource BoolVis}}"/>
                <ItemsControl ItemsSource="{Binding ImmediateActions}" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" BorderThickness="2"
                                    BorderBrush="{StaticResource DangerBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}"
                                              VerticalAlignment="Center" Margin="0,0,12,0" FontSize="16"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⏱ " FontSize="11"/>
                                            <TextBlock Text="{Binding EstimatedTime}" FontSize="11" Margin="0,0,12,0"/>
                                            <TextBlock Text="👷 " FontSize="11"/>
                                            <TextBlock Text="{Binding SkillLevel}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Scheduled -->
                <TextBlock Text="📅 Scheduled Actions" FontWeight="Bold" FontSize="15"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"
                           Visibility="{Binding ScheduledActions.Count, Converter={StaticResource BoolVis}}"/>
                <ItemsControl ItemsSource="{Binding ScheduledActions}" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏱ " FontSize="11"/>
                                        <TextBlock Text="{Binding EstimatedTime}" FontSize="11" Margin="0,0,12,0"/>
                                        <TextBlock Text="👷 " FontSize="11"/>
                                        <TextBlock Text="{Binding SkillLevel}" FontSize="11"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Parts}"
                                                  Visibility="{Binding Parts.Count, Converter={StaticResource BoolVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource PrimaryBrush}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Monitor -->
                <TextBlock Text="👁 Monitor" FontWeight="Bold" FontSize="15"
                           Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,8"
                           Visibility="{Binding MonitorActions.Count, Converter={StaticResource BoolVis}}"/>
                <ItemsControl ItemsSource="{Binding MonitorActions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Compute Risk Predictions  →" Command="{Binding ProceedCommand}"
                    Style="{StaticResource AccentButton}"/>
            <TextBlock Text="Computing 30/60/90-day risks…" Style="{StaticResource CaptionText}"
                       Visibility="{Binding IsGeneratingPrediction, Converter={StaticResource BoolVis}}"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
