<UserControl x:Class="VPMS.Views.IssuesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VPMS.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
        <converters:SeverityToColorConverter x:Key="SevColor"/>
        <converters:DoubleToPercentConverter x:Key="DblPct"/>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header — Gate 1 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                    <TextBlock Text="GATE 1 — Engineer Review" Foreground="White" FontWeight="Bold" FontSize="11"/>
                </Border>
                <TextBlock Text="Detected Issues" Style="{StaticResource SectionHeader}" Margin="0"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"/>
        </StackPanel>

        <!-- Issues list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Approve checkbox -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsApproved}"
                                          VerticalAlignment="Center" Margin="0,0,16,0" FontSize="16"/>

                                <!-- Issue details -->
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Background="{Binding Severity, Converter={StaticResource SevColor}}"
                                                CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Severity}" Foreground="White"
                                                       FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <Border Background="#EEF3F8" CornerRadius="4" Padding="7,2" Margin="0,0,8,0"
                                                Visibility="{Binding IsCustom, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="Custom" Foreground="{StaticResource PrimaryBrush}" FontSize="11"/>
                                        </Border>
                                        <TextBlock Text="{Binding Subsystem}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Evidence}" Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                                        <Run Text="Confidence: "/>
                                        <Run Text="{Binding Confidence, Mode=OneWay, Converter={StaticResource DblPct}}"
                                             FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Remove button -->
                                <Button Grid.Column="2" Content="✕" VerticalAlignment="Top"
                                        Command="{Binding DataContext.RemoveIssueCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        FontSize="14" Cursor="Hand" Padding="4"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Add custom issue form -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding ShowAddIssueForm, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Text="Add Custom Issue" Style="{StaticResource SubHeader}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding NewIssueTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBox}"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding SeverityOptions}"
                              SelectedItem="{Binding NewIssueSeverity}"
                              Style="{StaticResource InputCombo}"/>
                    <TextBox Grid.Column="4"
                             Text="{Binding NewIssueSubsystem, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBox}"/>
                </Grid>
                <TextBox Text="{Binding NewIssueDescription, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}" Margin="0,8,0,8" MinHeight="60"
                         TextWrapping="Wrap" AcceptsReturn="True"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add Issue" Command="{Binding AddCustomIssueCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Cancel" Command="{Binding CancelAddFormCommand}"
                            Style="{StaticResource OutlineButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Action bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="+ Add Custom Issue" Command="{Binding ShowAddFormCommand}"
                    Style="{StaticResource OutlineButton}" Margin="0,0,12,0"/>
            <Button Content="Proceed to RCA  →" Command="{Binding ProceedCommand}"
                    Style="{StaticResource AccentButton}"
                    IsEnabled="{Binding IsProcessing, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
            <TextBlock Text="Running RCA…" Style="{StaticResource CaptionText}"
                       Visibility="{Binding IsProcessing, Converter={StaticResource BoolVis}}"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
