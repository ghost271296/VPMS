<UserControl x:Class="VPMS.Views.QueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VPMS.Converters"
             xmlns:models="clr-namespace:VPMS.Models"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
        <converters:InputTypeToVisibilityConverter x:Key="InputTypeVis"/>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Field Questions" Style="{StaticResource SectionHeader}"/>
            <TextBlock Style="{StaticResource CaptionText}">
                <Run Text="{Binding AnsweredCount}"/>
                <Run Text=" of "/>
                <Run Text="{Binding TotalQueries}"/>
                <Run Text=" questions answered. These targeted questions refine the diagnosis."/>
            </TextBlock>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Queries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:QueryItem}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Background="#EEF3F8" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding InputType}" FontSize="11"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Unit}" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding Unit, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Question}" FontWeight="SemiBold" FontSize="14"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Rationale}" Style="{StaticResource CaptionText}"
                                           Margin="0,0,0,10"/>

                                <!-- Boolean input -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding InputType, ConverterParameter=Boolean, Converter={StaticResource InputTypeVis}}">
                                    <RadioButton Content="Yes" Margin="0,0,16,0"
                                                 IsChecked="{Binding Answer, Converter={StaticResource BoolVis}}"/>
                                    <RadioButton Content="No"/>
                                </StackPanel>

                                <!-- Text / Numeric input -->
                                <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBox}"
                                         Visibility="{Binding InputType, ConverterParameter=Text, Converter={StaticResource InputTypeVis}}"/>

                                <!-- MultiChoice -->
                                <ComboBox ItemsSource="{Binding Choices}"
                                          SelectedItem="{Binding Answer}"
                                          Style="{StaticResource InputCombo}"
                                          Visibility="{Binding InputType, ConverterParameter=MultiChoice, Converter={StaticResource InputTypeVis}}"/>

                                <!-- Date input -->
                                <DatePicker
                                    Visibility="{Binding InputType, ConverterParameter=Date, Converter={StaticResource InputTypeVis}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Generate Fishbone  →" Command="{Binding ProceedCommand}"
                    Style="{StaticResource AccentButton}"/>
            <TextBlock Text="Building fishbone diagram…" Style="{StaticResource CaptionText}"
                       Visibility="{Binding IsGeneratingFishbone, Converter={StaticResource BoolVis}}"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
