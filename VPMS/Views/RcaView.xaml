<UserControl x:Class="VPMS.Views.RcaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VPMS.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
        <converters:DoubleToPercentConverter x:Key="DblPct"/>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Root Cause Analysis" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding RootCauses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <!-- Rank circle -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                        Background="{StaticResource PrimaryBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Rank}" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Background="#EEF3F8" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource PrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <!-- Supporting evidence -->
                                    <ItemsControl ItemsSource="{Binding SupportingEvidence}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                    <TextBlock Text="✓ " Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Conflicting evidence -->
                                    <ItemsControl ItemsSource="{Binding ConflictingEvidence}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                    <TextBlock Text="⚠ " Foreground="{StaticResource WarningBrush}" FontSize="11"/>
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Probability bar -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Probability, Converter={StaticResource DblPct}}"
                                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="probability" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Confidence, Converter={StaticResource DblPct}}"
                                               Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="confidence" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Proceed to Field Questions  →" Command="{Binding ProceedCommand}"
                    Style="{StaticResource AccentButton}"
                    IsEnabled="{Binding IsGeneratingQueries, Converter={StaticResource BoolVis}}"/>
            <TextBlock Text="Generating questions…" Style="{StaticResource CaptionText}"
                       Visibility="{Binding IsGeneratingQueries, Converter={StaticResource BoolVis}}"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
