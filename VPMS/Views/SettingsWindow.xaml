<Window x:Class="VPMS.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:VPMS.Converters"
        Title="VPMS Settings"
        Width="520" Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
        <converters:HealthScoreToColorConverter x:Key="HealthColor"/>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Settings" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Configure your OpenAI API key for the AI diagnostic pipeline."
                       Style="{StaticResource CaptionText}"/>
        </StackPanel>

        <!-- Status indicator -->
        <Border Grid.Row="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFF3CD"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                            <Setter Property="Background" Value="#D4EDDA"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="16" Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="⚠"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                    <Setter Property="Text" Value="✅"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="13"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- API Key label -->
        <TextBlock Grid.Row="2" Text="OpenAI API Key" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>

        <!-- API Key input -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="ApiKeyBox" Grid.Column="0" FontSize="13" Padding="10,7"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                         PasswordChanged="ApiKeyBox_PasswordChanged"/>
            <Button Grid.Column="2" Content="Clear" Command="{Binding ClearKeyCommand}"
                    Style="{StaticResource OutlineButton}" Padding="12,7"/>
        </Grid>

        <!-- Hint -->
        <TextBlock Grid.Row="4" Margin="0,6,0,0"
                   Style="{StaticResource CaptionText}"
                   Text="Key is stored in %AppData%\VPMS\settings.json. Without a key, the system uses rule-based fallback detection."/>

        <!-- Action buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save &amp; Test Connection" Command="{Binding SaveAndTestCommand}"
                    Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                    IsEnabled="{Binding IsTesting, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
            <Button Content="Close" Click="Close_Click" Style="{StaticResource OutlineButton}"/>
        </StackPanel>
    </Grid>
</Window>
