<UserControl x:Class="VPMS.Views.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VPMS.Converters"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
        <converters:NullToVisibilityConverter x:Key="NullVis"/>
        <converters:HealthScoreToColorConverter x:Key="HealthColor"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Upload &amp; Validate Logs" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Drop your DataLog.xlsx and AlarmLog.xlsx files or use the file picker. VPMS will validate, score quality, and extract features automatically."
                           Style="{StaticResource CaptionText}"/>
            </StackPanel>

            <!-- Session metadata -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Engineer Name" Style="{StaticResource CaptionText}"/>
                        <TextBox Text="{Binding EngineerName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Site ID" Style="{StaticResource CaptionText}"/>
                        <TextBox Text="{Binding SiteId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="UPS Model" Style="{StaticResource CaptionText}"/>
                        <TextBox Text="{Binding UpsModel, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Serial Number" Style="{StaticResource CaptionText}"/>
                        <TextBox Text="{Binding UpsSerial, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- File drop zones -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- DataLog drop zone -->
                <Border Grid.Column="0" Style="{StaticResource Card}"
                        AllowDrop="True" Drop="DataLogDrop_Drop" DragOver="Drop_DragOver">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📊" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="DataLog.xlsx" Style="{StaticResource SubHeader}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Required — drag &amp; drop or browse"
                                   Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding DataLogPath}" Style="{StaticResource CaptionText}"
                                   Visibility="{Binding HasDataLog, Converter={StaticResource BoolVis}}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300" HorizontalAlignment="Center"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,8"/>
                        <Button Content="Browse DataLog" Command="{Binding BrowseDataLogCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- AlarmLog drop zone -->
                <Border Grid.Column="2" Style="{StaticResource Card}"
                        AllowDrop="True" Drop="AlarmLogDrop_Drop" DragOver="Drop_DragOver">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔔" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="AlarmLog.xlsx" Style="{StaticResource SubHeader}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Optional — drag &amp; drop or browse"
                                   Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding AlarmLogPath}" Style="{StaticResource CaptionText}"
                                   Visibility="{Binding HasAlarmLog, Converter={StaticResource BoolVis}}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300" HorizontalAlignment="Center"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,8"/>
                        <Button Content="Browse AlarmLog" Command="{Binding BrowseAlarmLogCommand}"
                                Style="{StaticResource OutlineButton}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Analyze button + progress -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Button Content="▶  Analyze" Command="{Binding AnalyzeCommand}"
                            IsEnabled="{Binding AnalysisReady}"
                            Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Left" FontSize="15" Padding="24,12"/>

                    <ProgressBar Value="{Binding AnalysisProgress}" Maximum="100"
                                 Style="{StaticResource VpmsProgress}" Margin="0,12,0,4"
                                 Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding AnalysisStatus}" Style="{StaticResource CaptionText}"
                               Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolVis}}"/>

                    <!-- Errors -->
                    <ItemsControl ItemsSource="{Binding ParseErrors}"
                                  Visibility="{Binding ParseErrors.Count, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource DangerBrush}"
                                           FontSize="12" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Data Quality Report -->
            <Border Grid.Row="4" Style="{StaticResource Card}"
                    Visibility="{Binding ShowQualityReport, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="Data Quality Report" Style="{StaticResource SubHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Score circle -->
                        <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40" Margin="0,0,20,0"
                                Background="{Binding QualityReport.Score, Converter={StaticResource HealthColor}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding QualityReport.Score}" FontSize="22" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="/100" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding QualityReport.Grade}" FontWeight="Bold" FontSize="16"
                                           Foreground="{Binding QualityReport.Score, Converter={StaticResource HealthColor}}"/>
                                <TextBlock Text=" — " Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding QualityReport.TotalRows, StringFormat='{}{0} rows'}"
                                           Style="{StaticResource CaptionText}"/>
                                <TextBlock Text=", " Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding QualityReport.LogDuration, StringFormat='{}{0:hh\\:mm\\:ss} duration'}"
                                           Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding QualityReport.Warnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding QualityReport.Recommendations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource SuccessBrush}" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
